<Window x:Class="AudioDual.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Dual Audio Manager" 
        Height="620" Width="800"
        Background="#121212"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI, Roboto, Outfit, sans-serif"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="app.png">
    
    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Accent buttons -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button for Devices -->
        <Style x:Key="DeviceToggleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="4" Background="#2A2A2A" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- Header -->
            <RowDefinition Height="*"/>         <!-- Device list -->
            <RowDefinition Height="Auto"/>      <!-- Settings & Controls -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="WINDOWS DUAL AUDIO MANAGER" FontSize="20" FontWeight="Bold" Foreground="#0098FF"/>
                <TextBlock x:Name="txtVersion" Text="v1.2.0" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="REFRESH DEVICES" Click="BtnRefresh_Click" Style="{StaticResource AccentButton}"/>
        </Grid>

        <!-- Device list -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icDevices">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Device item card -->
                            <Border x:Name="CardBorder" Background="#262626" CornerRadius="6" Margin="5" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>         <!-- Name & Badge -->
                                        <ColumnDefinition Width="200"/>       <!-- Volume Slider -->
                                        <ColumnDefinition Width="120"/>       <!-- Action Button -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Top Left: Device name & role info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center"/>
                                        
                                        <!-- Badges based on status -->
                                        <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center" x:Name="StatusBadge">
                                            <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Volume control -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Volume:" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                                        <Slider Width="100" Minimum="0" Maximum="100" Value="{Binding VolumePercent}" 
                                                IsEnabled="{Binding IsEnabled}"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VolumeText}" Width="40" Margin="10,0,0,0" TextAlignment="Right" Foreground="#0098FF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <Button Grid.Column="2" x:Name="btnToggle" Content="{Binding ActionText}" IsEnabled="{Binding IsButtonEnabled}" Tag="{Binding}" Click="BtnToggleDevice_Click" Style="{StaticResource DeviceToggleButton}" VerticalAlignment="Center"/>

                                    <!-- Real-time Level Meter (Spans whole bottom of card when enabled) -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding MeterVisibility}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Peak Meter Label -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Level Meter" FontSize="11" Foreground="#888888" Width="70" VerticalAlignment="Center"/>
                                        
                                        <!-- Meter bars -->
                                        <Grid Grid.Row="0" Grid.Column="1" Height="10">
                                            <ProgressBar Value="{Binding PeakValue}" Minimum="0" Maximum="100" BorderThickness="0" Background="#121212" Foreground="#00CC66" Height="4" VerticalAlignment="Top"/>
                                            <ProgressBar Value="{Binding RmsValue}" Minimum="0" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="#0098FF" Height="4" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Capture Source">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#008080"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#2E7D32"/>
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2E7D32"/>
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#424242"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Settings Pane -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>         <!-- Latency Settings -->
                    <ColumnDefinition Width="220"/>       <!-- App Settings -->
                    <ColumnDefinition Width="Auto"/>      <!-- Save Action -->
                </Grid.ColumnDefinitions>

                <!-- Left: Audio Latency Config -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="PIPELINE LATENCY BUDGET" FontSize="12" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderLatency" Minimum="15" Maximum="500" Value="25" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="txtLatencyVal" Text="25 ms" Width="60" TextAlignment="Right" FontWeight="SemiBold" Foreground="#0098FF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Lower values reduce delay but may stutter. Wired devices run at ~15-25ms. Wireless (Bluetooth) auto-scales to its hardware limit." FontSize="10" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Center: Startup / Minimize preferences -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <CheckBox x:Name="chkStartMinimized" Content="Start Minimized to System Tray" Foreground="#E0E0E0" Margin="0,0,0,6" Cursor="Hand"/>
                    <CheckBox x:Name="chkRunAtStartup" Content="Run Automatically at Startup" Foreground="#E0E0E0" Margin="0,0,0,6" Cursor="Hand"/>
                    <CheckBox x:Name="chkExclusiveMode" Content="Prefer WASAPI Exclusive Mode" Foreground="#E0E0E0" Cursor="Hand"/>
                </StackPanel>

                <!-- Right: Save Settings -->
                <Button Grid.Column="2" Content="SAVE SETTINGS" Click="BtnSaveSettings_Click" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
